{
  "name": "schema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Martins skolschema – en PWA som visar ett ICS-flöde som schema",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm test && npm run build && wrangler deploy",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "happy-dom": "20.14.6",
    "playwright-core": "^1.64.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "ical.js": "2.2.1",
    "zod": "4.6.5"
  }
}
